MODEL_PROVIDER=gemini

# Gemini Developer API
GOOGLE_API_KEY=replace-with-your-google-api-key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Azure OpenAI v1 API
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-api-key
AZURE_OPENAI_MODEL=gpt-5.5
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# LINE Messaging API（第一、二單元使用，請填入真實 Channel 憑證）
LINE_CHANNEL_SECRET=replace-with-your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-your-line-channel-access-token

# Ollama 本地模型（第五單元使用，不需要 API Key）
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434

# 模型與 Deployment 名稱須在開課前依帳號權限實測。
